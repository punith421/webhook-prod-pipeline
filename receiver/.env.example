# Copy to .env for local runs (docker-compose supplies these automatically)

PORT=4000
NODE_ENV=production
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhooks?schema=public

# Long random shared secret used to verify incoming webhook signatures.
# Generate one with: openssl rand -hex 32
# Leave blank only for local dev without signature checking.
WEBHOOK_SECRET=

# How many messages one worker process handles concurrently.
CONCURRENCY=20

# How many times BullMQ retries a failed job before giving up.
MAX_ATTEMPTS=5

# Requests per minute allowed per IP on POST /webhook.
RATE_LIMIT_PER_MINUTE=6000

LOG_LEVEL=info
