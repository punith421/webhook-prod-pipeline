  "description": "Production webhook receiver: durable Redis/BullMQ queue, HMAC verification, retries, idempotency, horizontal scaling",
  "main": "src/server.js",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
