    "start:worker": "node src/worker.js",
    "dev": "NODE_ENV=development node src/server.js",
    "dev:worker": "NODE_ENV=development node src/worker.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "prisma": "^5.22.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2"
  }
}
